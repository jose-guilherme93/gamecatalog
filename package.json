{
  "name": "gamecatalog-monorepo",
  "private": true,
  "description": "Monorepo GameCatalog - API nodejs",
  "type": "module",
  "scripts": {
    "api:dev": "pnpm --filter @gamecatalog/api dev",
    "api:prod": "infisical run -- NODE_ENV=prod pnpm --filter @gamecatalog/api start",
    "api:act": "infisical run -- NODE_ENV=act pnpm --filter @gamecatalog/api dev",
    "api:migrate:dev": "pnpm --filter @gamecatalog/api migrate:dev",
    "api:build": "NODE_ENV=prod pnpm --filter @gamecatalog/api build",
    "api:type-check": "NODE_ENV=prod pnpm --filter @gamecatalog/api type-check",
    "dev": "pnpm worker:dev & pnpm api:dev",
    "worker:dev": "infisical run -- pnpm --filter @gamecatalog/worker-donations dev",
    "prepare": "husky",
    "test": "pnpm --filter @gamecatalog/api test"
  },
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "husky": "^9.1.7"
  },
  "dependencies": {
    "redis": "^5.10.0"
  }
}