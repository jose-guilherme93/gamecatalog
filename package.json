{
  "name": "gamecatalog",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "test": "node ./node_modules/vitest/vitest.mjs",
    "start": "NODE_ENV=prod node dist/server.js",
    "migrate:dev": "tsx src/scripts/exec-migrations.ts --dotenv_config_path=.env.dev",
    "migrate:prod": "node dist/scripts/exec-migrations.js --dotenv_config_path=.env.prod",
    "insert-data": "tsx src/scripts/seedDb.ts --dotenv_config_path=.env.dev",
    "dev": "tsx watch src/server.ts --dotenv_config_path=.env.dev",
    "build": "tsc && tsc-alias && cp -R src/migrations dist/migrations",
    "prepare": "husky"
  },
  "keywords": [],
  "type": "module",
  "author": "Joseti",
  "license": "ISC",
  "packageManager": "pnpm@10.24.0",
  "dependencies": {
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^7.0.11",
    "pg": "^8.16.3",
    "socket.io": "^4.8.1",
    "tsconfig-paths": "^4.2.0",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.4",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.16.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^3.2.4"
  }
}
